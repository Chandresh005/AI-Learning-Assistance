# ========================================================
# AI-Powered Interactive Learning Assistant — Environment Variables
# ========================================================

# --- Application Configuration ---
PROJECT_NAME="AI Learning Assistant"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database & Cache ---
# PostgreSQL connection string with pgvector support
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_learning_assistant"
# Fallback local sqlite for development without docker/postgres:
# DATABASE_URL="sqlite+aiosqlite:///./ai_learning_assistant.db"

REDIS_URL="redis://localhost:6379/0"

# --- CORS Settings ---
# Comma-separated allowed frontend origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- AI & LLM Providers ---
# At least one LLM API key is required for RAG & Quiz generation
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""

# AI Models
LLM_MODEL="gpt-4o-mini"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# --- Transcription (faster-whisper) ---
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"

# --- File Storage ---
UPLOAD_DIR="./data"

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL="http://localhost:8000/api"
NEXT_PUBLIC_APP_NAME="AI Learning Assistant"
